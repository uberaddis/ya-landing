# Browser-reachable GraphQL endpoints for the public account-deletion flow.
# Confirm the deployed Traefik host with ops before using these production values.
# Do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_RIDER_API_GRAPHQL_URL=https://yaride.et/rider-api/graphql
NEXT_PUBLIC_DRIVER_API_GRAPHQL_URL=https://yaride.et/driver-api/graphql
